# Server
PORT=3001
# Environment: 'development' locally, 'production' in any deployed environment.
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/longevity_db
DB_SYNCHRONIZE=false

# Encryption (must be exactly 32 characters — used for AES-256 at-rest encryption
# of meal.imageUrl and health_log.data). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
# Keep this stable across restarts/deploys — rotating it makes previously-encrypted
# rows permanently undecryptable.
ENCRYPTION_KEY=

# Auth (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

# JWT
# min 32 random chars, no placeholder words; generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Dev-only: uncomment to expose GET /auth/mock-login (mints a session JWT for a fake student).
# ENABLE_MOCK_LOGIN=true
