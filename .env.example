# Supabase Configuration
# Copy this file to .env and fill in your project credentials

VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin user management runs server-side in the `admin-users` Supabase Edge
# Function. The service_role key lives only in that function's environment and
# must never be added here or to any VITE_-prefixed variable.
